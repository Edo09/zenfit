# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
#
# Connection strings: Dashboard -> Connect -> "Session pooler" (port 5432).
# Put the database password in place of [YOUR-PASSWORD]; if it contains
# special characters (@ : / # ? etc.), URL-encode them.

# The OLD shared project (becomes Hokage-only) -- only ever READ.
OLD_DB_URL=postgresql://postgres.rzgwkwxskrovxnnymxqo:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
OLD_SUPABASE_URL=https://rzgwkwxskrovxnnymxqo.supabase.co

# Zyron's NEW project -- zyron_database_setup.sql must already have run there.
NEW_DB_URL=postgresql://postgres.[ZYRON-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
NEW_SUPABASE_URL=https://[ZYRON-REF].supabase.co
# Settings -> API Keys: the SECRET key (sb_secret_...) or the legacy service_role key.
# Only used to upload files into the new project's Storage.
NEW_SECRET_KEY=

# Optional: path to Supabase's CA certificate to verify the database TLS
# certificate (Dashboard -> Database -> SSL Configuration -> Download).
SUPABASE_CA_CERT=
